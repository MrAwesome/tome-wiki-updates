{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review.schema.json",
  "title": "ToME talent workflow record",
  "description": "Human workflow state and tool-owned provenance for one work-area talent.",
  "type": "object",
  "required": [
    "schema_version",
    "identity",
    "baseline",
    "state",
    "workflow_status",
    "notes",
    "automation",
    "blocked_by",
    "render",
    "work_page",
    "history"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "identity": {
      "type": "object",
      "required": ["kind", "filename", "wiki_title", "pageid"],
      "properties": {
        "kind": {"const": "talent"},
        "filename": {"type": "string", "minLength": 1},
        "wiki_title": {"type": "string", "minLength": 1},
        "pageid": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "baseline": {
      "type": "object",
      "required": ["revid", "page_sha256"],
      "properties": {
        "revid": {"type": "integer", "minimum": 1},
        "page_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": true
    },
    "state": {
      "enum": ["update", "keep", "ignore", "defer", "mark_out_of_date"]
    },
    "workflow_status": {
      "enum": [
        "untriaged",
        "queued",
        "in_progress",
        "needs_source_review",
        "needs_human_review",
        "blocked",
        "approved",
        "rejected",
        "finalized"
      ]
    },
    "notes": {"type": "string"},
    "automation": {
      "type": "object",
      "required": ["deterministic", "llm"],
      "properties": {
        "deterministic": {
          "type": "object",
          "required": ["mode", "notes"],
          "properties": {
            "mode": {"enum": ["run", "skip"]},
            "notes": {"type": "string"}
          },
          "additionalProperties": true
        },
        "llm": {
          "type": "object",
          "required": ["mode", "instructions"],
          "properties": {
            "mode": {"enum": ["allow", "skip"]},
            "instructions": {
              "type": "array",
              "items": {"type": "string"}
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "reason"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "source": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["candidate", "no_change", "unsupported_info", "unmatched_source"]
        },
        "updated_at": {"type": "string", "format": "date-time"},
        "source_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "candidate_page_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      },
      "additionalProperties": true
    },
    "work_page": {
      "type": "object",
      "required": ["last_managed_sha256"],
      "properties": {
        "last_managed_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "last_writer": {"type": "string"}
      },
      "additionalProperties": true
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "actor", "event"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "actor": {"type": "string", "minLength": 1},
          "event": {"type": "string", "minLength": 1},
          "from": {},
          "to": {},
          "reason": {"type": "string"},
          "commit": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "mark_out_of_date"}}, "required": ["state"]},
      "then": {"properties": {"notes": {"type": "string", "pattern": "\\S"}}}
    },
    {
      "if": {"properties": {"workflow_status": {"const": "blocked"}}, "required": ["workflow_status"]},
      "then": {"properties": {"blocked_by": {"minItems": 1}}}
    },
    {
      "if": {
        "properties": {
          "automation": {
            "properties": {"deterministic": {"properties": {"mode": {"const": "skip"}}}}
          }
        }
      },
      "then": {
        "properties": {
          "automation": {
            "properties": {"deterministic": {"properties": {"notes": {"type": "string", "pattern": "\\S"}}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"render": {"required": ["status"]}}, "required": ["render"]},
      "then": {"properties": {"render": {"required": ["updated_at"]}}}
    },
    {
      "if": {"properties": {"render": {"required": ["updated_at"]}}, "required": ["render"]},
      "then": {"properties": {"render": {"required": ["status"]}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
